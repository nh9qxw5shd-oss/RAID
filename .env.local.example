# ─── Supabase ────────────────────────────────────────────────────────────
# Public flag pair — their presence switches the app from local (browser
# storage) mode into server mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the API routes for all database access (RLS is
# locked down — the anon key is read-only on published debriefs). Never
# expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (optional) ─────────────────────────────────────────────────────
# Secret for signing session cookies and print tokens. If unset, one is
# derived from the service role key.
# AUTH_SECRET=

# ─── Publish emails (optional) ───────────────────────────────────────────
# Without RESEND_API_KEY, publishing still works but no notice is emailed.
# RESEND_FROM must be a sender on a domain verified in your Resend account.
# RESEND_API_KEY=
# RESEND_FROM="RAID Debrief <raid@example.com>"

# ─── PDF rendering (optional) ────────────────────────────────────────────
# The publish email renders the report PDF with @sparticuz/chromium
# (serverless build, used on Vercel). For local development point this at
# an installed Chromium/Chrome binary instead.
# PDF_CHROMIUM_PATH=/usr/bin/chromium
